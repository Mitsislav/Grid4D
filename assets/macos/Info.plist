				<string>io.github.mitsislav.grid4d.document</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.mitsislav.grid4d.document</string>
			<key>UTTypeDescription</key>
			<string>Grid4D Document</string>
			<key>UTTypeIconFile</key>
			<string>grid4d.icns</string>
